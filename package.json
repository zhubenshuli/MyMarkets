{
  "name": "mymarkets",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev:web": "vite --port 4081",
    "dev:server": "node --env-file-if-exists=.env --watch src/server/main.ts",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env src/server/main.ts",
    "refresh": "node --env-file-if-exists=.env scripts/refresh.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-timeout=60000 \"tests/*.test.ts\""
  },
  "dependencies": {
    "fastify": "5.12.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "undici": "7.30.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.3"
  }
}
