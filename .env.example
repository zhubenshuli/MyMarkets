# MyMarkets 独立行情服务配置

# 服务监听配置
HOST=0.0.0.0
PORT=4080

# SQLite 数据存储目录（默认创建 /data/markets.db，本地开发默认使用 .data/markets.db）
DATA_DIR=.data

# 安全阀：只有设为 true 才启动定时采集或模型研判
COLLECT_ENABLED=true
MODEL_CALLS_ENABLED=true

# 默认大模型配置（OpenAI 兼容接口，用于每日零点生猪/航空/恒生科技智能研判，失败或关闭时自动回退至产业规则引擎）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-flash
LLM_CHANNEL_1_QUOTA_MODE=http-status
LLM_EXTRA_JSON={"thinking":{"type":"disabled"}}
LLM_RPM=5
LLM_TOKEN_THRESHOLD=50000

# 可选：指定行情研判专用模型名称（覆盖 LLM_MODEL）
# MARKET_ANALYSIS_MODEL=

# 可选：多通道容灾配置（按序轮转，支持 nvidia / apinex / tokenharbor / subscription / http-status 配额检测模式）
# LLM_CHANNEL_2_BASE_URL=
# LLM_CHANNEL_2_API_KEY=
# LLM_CHANNEL_2_MODEL=
# LLM_CHANNEL_2_QUOTA_MODE=apinex
# LLM_CHANNEL_3_BASE_URL=
# LLM_CHANNEL_3_API_KEY=
# LLM_CHANNEL_3_MODEL=
# LLM_CHANNEL_3_QUOTA_MODE=tokenharbor

# 可选：抓取外部行情接口代理
# EGRESS_PROXY_URL=http://127.0.0.1:7890
